# =====================================================================
# Local configuration template. Copy to .env (git-ignored) and fill in.
#   cp .env.example .env
# Generate secrets with:
#   API_KEY:              openssl rand -hex 32
#   JWT_SECRET:           openssl rand -base64 32
#   CARD_ENCRYPTION_KEY:  openssl rand -base64 32
# =====================================================================

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=tokenization
POSTGRES_USER=tokenization
POSTGRES_PASSWORD=change-me

# --- Security (required, the app refuses to start without them) ---
API_KEY=
JWT_SECRET=
JWT_TTL=30m

# --- Card encryption (AES-256-GCM key, Base64, 32 bytes) ---
CARD_ENCRYPTION_KEY=

# --- Business parameters (optional, defaults shown) ---
TOKENIZATION_REJECTION_PROBABILITY=0.1
PAYMENT_REJECTION_PROBABILITY=0.3
PAYMENT_MAX_RETRIES=3
PAYMENT_RETRY_BACKOFF=200ms
PRODUCT_MIN_STOCK=0

# --- Email ---
# Local: docker compose points SMTP to Mailpit (UI http://localhost:8025) and these are ignored.
# Cloud (Brevo): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_AUTH=true SMTP_STARTTLS=true
#                SMTP_USERNAME=<login xxx@smtp-brevo.com> SMTP_PASSWORD=<SMTP key> (Secret Manager in GCP)
# MAIL_FROM must be a verified sender at the provider
MAIL_FROM=no-reply@payment-tokenization.dev

# Retry of failed async listeners (e.g. SMTP down)
EVENTS_RETRY_INTERVAL=1m
EVENTS_RETRY_MIN_AGE=1m
EVENTS_RETRY_MAX_ATTEMPTS=5
